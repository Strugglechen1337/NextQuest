[Unit]
Description=NextQuest application (loopback only)
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/nextquest
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=7918
Environment=DATA_DIR=%h/nextquest/data
EnvironmentFile=%h/.config/nextquest/deploy.env
ExecStart=/usr/bin/node %h/nextquest/.next/standalone/server.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/nextquest/data
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
MemoryMax=768M
TasksMax=64

[Install]
WantedBy=default.target
