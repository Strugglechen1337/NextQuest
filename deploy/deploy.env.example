# Vorlage: Platzhalter durch absolute Pfade und passende Werte ersetzen.
# Die private Datei gehört nach ~/.config/nextquest/deploy.env und erhält Modus 0600.
NEXTQUEST_BIND=<server-ip>
NEXTQUEST_GATE_HOST=<server-ip>
NEXTQUEST_GATE_PORT=7916
NEXTQUEST_ALLOWED_HOSTS=<server-ip>:7916
NEXTQUEST_LAN=<lan-cidr>
NEXTQUEST_PIN_CONFIG=<absolute-path-to-pin-config.json>
NEXTQUEST_GATE_STATE=<absolute-path-to-gate-state.sqlite3>
NEXTQUEST_DB=<absolute-path-to-nextquest.db>
NEXTQUEST_BACKUP_DIR=<absolute-path-to-backup-directory>
NEXTQUEST_TELEGRAM_CHAT_ID=<telegram-chat-id>
NEXTQUEST_URL=http://127.0.0.1:7918
HERMES_SCRIPTS=<absolute-path-to-telegram-helper-directory>
NEXTQUEST_COMMIT=<deployed-commit-sha>
