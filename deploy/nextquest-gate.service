[Unit]
Description=NextQuest independent PIN gate
After=network.target

[Service]
Type=simple
WorkingDirectory=%h/nextquest/deploy
EnvironmentFile=%h/.config/nextquest/deploy.env
ExecStart=%h/nextquest/.venv/bin/python %h/nextquest/deploy/gate.py
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=read-only
ReadWritePaths=%h/nextquest/deploy/state
RestrictAddressFamilies=AF_INET AF_UNIX
MemoryMax=128M
TasksMax=24

[Install]
WantedBy=default.target
